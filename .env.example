# Copy this file to .env and fill in real values. Never commit .env itself.

# Supabase Postgres connection string (Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# JWT auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM API
ANTHROPIC_API_KEY=your-anthropic-api-key
# Model used for the explanation report (claude-opus-5 is the default; claude-sonnet-5 is cheaper)
ANTHROPIC_MODEL=claude-opus-5

# OpenRouter (https://openrouter.ai): one key, many models, some free. Find free model ids with:
#   python -m app.agent.check --list-free
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openrouter/free

# Who writes the report: auto = Claude if ANTHROPIC_API_KEY set, else OpenRouter if its key is set, else the
# built-in template. Force one with: claude | openrouter | template
REPORT_NARRATOR=auto

# CORS - comma separated origins allowed to call this API
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
