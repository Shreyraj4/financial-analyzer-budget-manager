# Copy this file to .env and fill in real values. Never commit .env itself.

# Supabase Postgres connection string (Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# JWT auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM API
ANTHROPIC_API_KEY=your-anthropic-api-key
# Model used for the explanation report (claude-opus-5 is the default; claude-sonnet-5 is cheaper)
ANTHROPIC_MODEL=claude-opus-5
# auto = use Claude when a key is set, otherwise the built-in template report; template = never call the API
REPORT_NARRATOR=auto

# CORS - comma separated origins allowed to call this API
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
